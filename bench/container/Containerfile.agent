# The sandbox each agent works in. Build context: bench/container/.
ARG BASE=pokedex-base
FROM ${BASE}

ARG CLAUDE_CODE_VERSION=latest
ARG AGENT_BROWSER_VERSION=0.39.2

USER root
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} agent-browser@${AGENT_BROWSER_VERSION}

USER agent
# IS_SANDBOX lets Claude Code run with --dangerously-skip-permissions; the container is the sandbox.
ENV IS_SANDBOX=1 \
    DISABLE_AUTOUPDATER=1
RUN agent-browser install

COPY --chown=agent:agent run-agent.sh setup-tooling.sh /home/agent/
ENTRYPOINT ["/home/agent/run-agent.sh"]
